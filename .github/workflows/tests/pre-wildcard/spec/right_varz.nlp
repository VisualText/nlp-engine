###############################################
# FILE:     right_varz.nlp
# SUBJ:     Rightward match: "two" has num, so varz fails the rule.
# NOTE:     Part of the pre-wildcard regression (#449); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@PRE
<2,2> varz("num");
@POST
  "output.txt" << "WRONG right varz" << "\n";
  noop();
@RULES
_xNIL <- one _xWILD [plus] three @@
