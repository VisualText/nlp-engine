###############################################
# FILE:     left_varz.nlp
# SUBJ:     Trigger on the last element, so the wildcard fills leftward.
# NOTE:     Part of the pre-wildcard regression (#449); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@PRE
<2,2> varz("num");
@POST
  "output.txt" << "WRONG left varz" << "\n";
  noop();
@RULES
_xNIL <- one _xWILD [plus] three [trig] @@
