###############################################
# FILE:     range_pre.nlp
# SUBJ:     numrange on a number. (@PRE form)
# NOTE:     Part of the element-pre regression (#438); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@PRE
<1,1> numrange(5, 10);
@POST
  "output.txt" << "range @PRE: " << phrasetext() << "\n";
  noop();
@RULES
_xNIL <- _xNUM @@
