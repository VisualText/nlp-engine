###############################################
# FILE:     regexp_pre.nlp
# SUBJ:     regexp (a glob match) on an alphabetic element. (@PRE form)
# NOTE:     Part of the element-pre regression (#438); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@PRE
<1,1> regexp("t*");
@POST
  "output.txt" << "regexp @PRE: " << phrasetext() << "\n";
  noop();
@RULES
_xNIL <- _xALPHA @@
