###############################################
# FILE:     two_pre.nlp
# SUBJ:     Two conditions on one element. (@PRE form)
# NOTE:     Part of the element-pre regression (#438); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@PRE
<1,1> var("num");
<1,1> varne("pos", "noun");
@POST
  "output.txt" << "two @PRE: " << phrasetext() << "\n";
  noop();
@RULES
_xNIL <- _xALPHA @@
