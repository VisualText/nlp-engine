###############################################
# FILE:     cap_pre.nlp
# SUBJ:     cap on an alphabetic element. (@PRE form)
# NOTE:     Part of the element-pre regression (#438); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@PRE
<1,1> cap();
@POST
  "output.txt" << "cap @PRE: " << phrasetext() << "\n";
  noop();
@RULES
_xNIL <- _xALPHA @@
