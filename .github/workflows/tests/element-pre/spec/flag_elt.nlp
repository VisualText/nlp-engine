###############################################
# FILE:     flag_elt.nlp
# SUBJ:     A bare action name with no arguments. (element-key form)
# NOTE:     Part of the element-pre regression (#438); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@POST
  "output.txt" << "flag elt : " << phrasetext() << "\n";
  noop();
@RULES
_xNIL <- _xALPHA [uppercase] @@
