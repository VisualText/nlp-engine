###############################################
# FILE:     varz_elt.nlp
# SUBJ:     varz on a wildcard between two words (#449 behaviour). (element-key form)
# NOTE:     Part of the element-pre regression (#438); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@POST
  "output.txt" << "varz elt : " << phrasetext() << "\n";
  noop();
@RULES
_xNIL <- two _xWILD [plus varz="num"] 3 @@
