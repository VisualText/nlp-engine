###############################################
# FILE:     flag_pre.nlp
# SUBJ:     A bare action name with no arguments. (@PRE form)
# NOTE:     Part of the element-pre regression (#438); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@PRE
<1,1> uppercase();
@POST
  "output.txt" << "flag @PRE: " << phrasetext() << "\n";
  noop();
@RULES
_xNIL <- _xALPHA @@
