###############################################
# FILE:     strjoin.nlp
# SUBJ:     strjoin() in interpreted and compiled analyzers. A compiled
#           analyzer calls it through Arun::fnbridge.
###############################################

@CODE
L("a")[0] = "x"; L("a")[1] = "y"; L("a")[2] = "z";
L("r") = strjoin(L("a"), "-");
"output.txt" << "strjoin: " << L("r") << "\n";
@@CODE
