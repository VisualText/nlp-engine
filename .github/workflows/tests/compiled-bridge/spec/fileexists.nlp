###############################################
# FILE:     fileexists.nlp
# SUBJ:     fileexists() in interpreted and compiled analyzers. A compiled
#           analyzer calls it through Arun::fnbridge.
###############################################

@CODE
L("r") = str(fileexists("no-such-file.txt"));
"output.txt" << "fileexists: " << L("r") << "\n";
@@CODE
