###############################################
# FILE:     arrayslice.nlp
# SUBJ:     arrayslice() in interpreted and compiled analyzers. A compiled
#           analyzer calls it through Arun::fnbridge.
###############################################

@CODE
L("a")[0] = "p"; L("a")[1] = "q"; L("a")[2] = "r";
L("b") = arrayslice(L("a"), 1);
L("r") = L("b")[0] + L("b")[1];
"output.txt" << "arrayslice: " << L("r") << "\n";
@@CODE
