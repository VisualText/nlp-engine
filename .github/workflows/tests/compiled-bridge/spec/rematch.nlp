###############################################
# FILE:     rematch.nlp
# SUBJ:     rematch() in interpreted and compiled analyzers. A compiled
#           analyzer calls it through Arun::fnbridge.
###############################################

@CODE
L("r") = str(rematch("abc", "a.c")) + str(rematch("abc", "x"));
"output.txt" << "rematch: " << L("r") << "\n";
@@CODE
