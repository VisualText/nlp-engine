###############################################
# FILE:     striscaps.nlp
# SUBJ:     striscaps() in interpreted and compiled analyzers. A compiled
#           analyzer calls it through Arun::fnbridge.
###############################################

@CODE
L("r") = str(striscaps("Hello")) + str(striscaps("hello"));
"output.txt" << "striscaps: " << L("r") << "\n";
@@CODE
