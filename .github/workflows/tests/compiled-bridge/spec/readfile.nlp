###############################################
# FILE:     readfile.nlp
# SUBJ:     readfile() in interpreted and compiled analyzers. A compiled
#           analyzer calls it through Arun::fnbridge.
###############################################

@CODE
L("r") = "[" + readfile("no-such-file.txt") + "]";
"output.txt" << "readfile: " << L("r") << "\n";
@@CODE
