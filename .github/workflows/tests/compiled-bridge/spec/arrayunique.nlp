###############################################
# FILE:     arrayunique.nlp
# SUBJ:     arrayunique() in interpreted and compiled analyzers. A compiled
#           analyzer calls it through Arun::fnbridge.
###############################################

@CODE
L("a")[0] = "x"; L("a")[1] = "x"; L("a")[2] = "y";
L("b") = arrayunique(L("a"));
L("r") = str(arraylength(L("b")));
"output.txt" << "arrayunique: " << L("r") << "\n";
@@CODE
