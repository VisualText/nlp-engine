###############################################
# FILE:     resubst.nlp
# SUBJ:     resubst() in interpreted and compiled analyzers. A compiled
#           analyzer calls it through Arun::fnbridge.
###############################################

@CODE
L("r") = resubst("abcabc", "b", "X");
"output.txt" << "resubst: " << L("r") << "\n";
@@CODE
