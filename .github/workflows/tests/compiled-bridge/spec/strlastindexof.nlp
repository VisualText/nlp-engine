###############################################
# FILE:     strlastindexof.nlp
# SUBJ:     strlastindexof() in interpreted and compiled analyzers. A compiled
#           analyzer calls it through Arun::fnbridge.
###############################################

@CODE
L("r") = strlastindexof("hello", "l");
"output.txt" << "strlastindexof: " << L("r") << "\n";
@@CODE
