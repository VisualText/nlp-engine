###############################################
# FILE:     t7.nlp
# SUBJ:     _xSTART rule: (prints the _red node from t6)
# NOTE:     Part of the xstart-wildcard regression (#430, #431). See
#           analyzer.seq for the list and the CI step for the expected output.
###############################################

@CODE
L("n") = pndown(pnroot());
while (L("n")) {
    if (pnname(L("n")) == "_red")
        cout() << "t6 reduced [" << pnvar(L("n"),"$text") << "]\n";
    L("n") = pnnext(L("n"));
}
@@CODE
