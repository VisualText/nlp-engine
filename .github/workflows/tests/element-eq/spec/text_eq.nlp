###############################################
# FILE:     text_eq.nlp
# SUBJ:     A text attribute. (attr=value form)
# NOTE:     Part of the element-eq regression (#438); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@POST
  "output.txt" << "text attr=value: " << phrasetext() << "\n";
  noop();
@RULES
_xNIL <- _xALPHA [pos="noun"] @@
