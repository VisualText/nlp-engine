###############################################
# FILE:     mark.nlp
# SUBJ:     Gives "two" pos=noun and "three" count=3.
# NOTE:     Part of the element-eq regression (#438); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@POST
  N("pos",1) = "noun";
  noop();
@RULES
_xNIL <- two @@

@POST
  N("count",1) = 3;
  noop();
@RULES
_xNIL <- three @@
