###############################################
# FILE:     number_vareq.nlp
# SUBJ:     A number attribute; digits compare as a number. (vareq= form)
# NOTE:     Part of the element-eq regression (#438); expected output
#           is in the CI step.
###############################################

@NODES _ROOT

@POST
  "output.txt" << "number vareq=: " << phrasetext() << "\n";
  noop();
@RULES
_xNIL <- _xALPHA [vareq=("count" 3)] @@
